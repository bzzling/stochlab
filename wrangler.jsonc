{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stochlab",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "stochlab.brandonling.ca",
      "custom_domain": true,
    },
  ],
  "workers_dev": false,
  "preview_urls": false,
}
